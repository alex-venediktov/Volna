# Контракт окружения «Волны». ЗНАЧЕНИЯ здесь не хранятся — это шаблон.
#
# После установки: скопировать в корень СВОЕГО рабочего репозитория как `.env` и заполнить.
#   cp .env.example <рабочий репозиторий>/.env
# `.env` уже в .gitignore и коммититься не должен — ни здесь, ни в рабочем репозитории.
# Секрет (PAT) в переменную не кладём: в переменной только ПУТЬ к файлу с ним.
#
# Проверить, что заполнено верно: /volna:doctor

# --- Трекер задач (TFS / on-prem Azure DevOps) ---
TFS_BASE_URL=              # URL коллекции: http://<host>/tfs/<Collection>
TFS_PROJECT=               # имя проекта в коллекции (нужно для wiql и создания задач)
TFS_AREA_PATH=             # (опц.) area path команды — фильтр поиска «мои задачи»
TFS_PAT_FILE=              # путь к файлу с PAT (utf-8-sig; BOM и края срезаются при чтении)
TFS_API_VERSION=5.0        # для on-prem 5.0; менять только если сервер требует иного
TFS_TARGET_BRANCH=         # (опц.) целевая ветка pull request по умолчанию (main, master, develop)
# Не заполнено — `volna-tfs pr create` требует явный --target: PR в чужую ветку не откатить.

# --- Рабочие репозитории (куда идут правки) ---
REPO_BACK=                 # git-репозиторий бэкенда — основной
REPO_FRONT=                # (опц.) git-репозиторий фронтенда
REPO_AGENT=                # (опц.) третий репозиторий для мульти-репо задач
# Незаполненная переменная = репозиторий не используется, этапы его молча пропускают.

# --- Эталон (референсная реализация, с которой сверяемся при порте) ---
DELPHI_REF_ROOT=           # корень исходников эталонного приложения
DELPHI_REF_MAIN=           # (опц.) ключевой файл-эталон, куда смотреть первым

# --- База знаний проекта (MCP) ---
KB_MCP_NAME=               # имя MCP-сервера базы знаний; пусто → искать Grep/Glob напрямую
KB_MCP_URL=                # (опц.) URL сервера, если он не локальный

# --- Фикстуры (оффлайн-снимки данных для тестов) ---
FIXTURE_DIR=               # (опц.) каталог снимков заказов/данных в JSON
# Живой доступ к БД «только на этот раз» не предусмотрен намеренно: тесты читают снимки.

# --- Утилиты проекта ---
TOOLS_DIR=                 # (опц.) каталог локальных утилит (дампы, рендер видов)
VISUAL_REF_DIR=            # (опц.) каталог эталонных скриншотов для визуальной сверки
