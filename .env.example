# Контракт окружения «Волны». ЗНАЧЕНИЯ здесь не хранятся — это шаблон.
#
# После установки: скопировать в корень СВОЕГО рабочего репозитория как `.env` и заполнить.
#   cp .env.example <рабочий репозиторий>/.env
# `.env` уже в .gitignore и коммититься не должен — ни здесь, ни в рабочем репозитории.
# Секрет (PAT) в переменную не кладём: в переменной только ПУТЬ к файлу с ним.
#
# Файл ищется вверх по дереву до корня репозитория (каталога с .git) и не выше: настройки
# берутся из своего проекта, а не из соседнего.
#
# Что из перечисленного вообще нужно, решает профиль проекта в `.volna/project.md`
# (секция «Профиль»): трекера нет — блок TFS не заполняется, эталона нет — блок эталона тоже.
# Проверить, что заполнено верно: /volna:doctor

# --- Рабочие репозитории (куда идут правки) ---
# Профиль `репозитории: один` — не заполнять ничего: работа идёт в репозитории с `.volna`.
# Профиль `репозитории: несколько` — по переменной на роль; имена ролей и их смысл описаны
# таблицей в `.volna/project.md`. Имя переменной любое, лишь бы начиналось с `REPO_`:
# REPO_MAIN=
# REPO_UI=
# Прежние имена REPO_BACK / REPO_FRONT / REPO_AGENT — частный случай, продолжают работать.
# Незаполненная переменная = репозиторий не используется, этапы его молча пропускают.

TARGET_BRANCH=             # целевая ветка PR и точка отвода новых веток (main, master, develop)
# Нужна на deliver: `volna-tfs pr create` без неё требует явный --target — PR в чужую ветку не
# откатить. Отказ всплывает в середине доставки, поэтому непустоту проверяет и /volna:doctor.
# Прежнее имя TFS_TARGET_BRANCH ещё читается.

# --- Трекер задач (профиль `трекер: tfs`; при `трекер: нет` блок не нужен) ---
TFS_BASE_URL=              # URL коллекции: http://<host>/tfs/<Collection>
TFS_PROJECT=               # имя проекта в коллекции (нужно для wiql и создания задач)
TFS_AREA_PATH=             # (опц.) area path команды — фильтр поиска «мои задачи»
TFS_PAT_FILE=              # путь к файлу с PAT (utf-8-sig; BOM и края срезаются при чтении)
TFS_API_VERSION=5.0        # для on-prem 5.0; менять только если сервер требует иного
#
# Обязательных полей процесса (контроль проекта, приоритет) здесь НЕТ намеренно: это знание о
# трекере, а не настройка машины. Смотреть — `volna-tfs fields <тип>`, задавать — `--field
# ref=значение`, снимать с соседней задачи области — `--like <id>`; постоянное значение области
# держать записью в `.volna/knowledge/tfs/`. Прежняя переменная TFS_CREATE_FIELDS ещё читается,
# но заводить её не надо.

# --- Эталон (профиль `эталон: delphi`; при `эталон: нет` блок не нужен) ---
REF_ROOT=                  # корень исходников эталонной реализации
REF_MAIN=                  # (опц.) ключевой файл-эталон, куда смотреть первым
# Прежние имена DELPHI_REF_ROOT / DELPHI_REF_MAIN ещё читаются.

# --- База знаний проекта (MCP) ---
KB_MCP_NAME=               # имя MCP-сервера базы знаний; пусто → искать Grep/Glob напрямую
KB_MCP_URL=                # (опц.) URL сервера, если он не локальный

# --- Фикстуры (оффлайн-снимки данных для тестов) ---
FIXTURE_DIR=               # (опц.) каталог снимков заказов/данных в JSON
# Живой доступ к БД «только на этот раз» не предусмотрен намеренно: тесты читают снимки.

# --- Утилиты проекта ---
TOOLS_DIR=                 # (опц.) каталог локальных утилит (дампы, рендер видов)
VISUAL_REF_DIR=            # (опц.) каталог эталонных скриншотов для визуальной сверки
